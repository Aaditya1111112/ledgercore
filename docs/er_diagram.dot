graph ER {
 graph [layout=neato, overlap=false, sep="+14", splines=true, bgcolor=white, pad=0.4, esep="+6"];
 node [fontname="Times-Italic", fontsize=13, color=black, fontcolor=black, style=solid];
 edge [color=black, penwidth=1.1];
 CUSTOMER [shape=box, fontname="Times-Bold", label="customer", width=1.6, height=0.5];
 CUSTOMER__customer_id [shape=ellipse, label=<<U>customer_id</U>>];
 CUSTOMER -- CUSTOMER__customer_id [len=1.3];
 CUSTOMER__full_name [shape=ellipse, label="full_name"];
 CUSTOMER -- CUSTOMER__full_name [len=1.3];
 CUSTOMER__email [shape=ellipse, label="email"];
 CUSTOMER -- CUSTOMER__email [len=1.3];
 CUSTOMER__phone [shape=ellipse, label="phone"];
 CUSTOMER -- CUSTOMER__phone [len=1.3];
 CUSTOMER__created_at [shape=ellipse, label="created_at"];
 CUSTOMER -- CUSTOMER__created_at [len=1.3];
 ACCOUNT [shape=box, fontname="Times-Bold", label="account", width=1.6, height=0.5];
 ACCOUNT__account_id [shape=ellipse, label=<<U>account_id</U>>];
 ACCOUNT -- ACCOUNT__account_id [len=1.3];
 ACCOUNT__account_no [shape=ellipse, label="account_no"];
 ACCOUNT -- ACCOUNT__account_no [len=1.3];
 ACCOUNT__account_type [shape=ellipse, label="account_type"];
 ACCOUNT -- ACCOUNT__account_type [len=1.3];
 ACCOUNT__balance [shape=ellipse, label="balance"];
 ACCOUNT -- ACCOUNT__balance [len=1.3];
 ACCOUNT__status [shape=ellipse, label="status"];
 ACCOUNT -- ACCOUNT__status [len=1.3];
 ACCOUNT__opened_at [shape=ellipse, label="opened_at"];
 ACCOUNT -- ACCOUNT__opened_at [len=1.3];
 ACCOUNT__closed_at [shape=ellipse, label="closed_at"];
 ACCOUNT -- ACCOUNT__closed_at [len=1.3];
 ACCOUNT__transaction_count [shape=ellipse, style=dashed, label="transaction_count"];
 ACCOUNT -- ACCOUNT__transaction_count [len=1.3];
 TRANSACTION [shape=box, fontname="Times-Bold", label="transaction", width=1.6, height=0.5];
 TRANSACTION__transaction_id [shape=ellipse, label=<<U>transaction_id</U>>];
 TRANSACTION -- TRANSACTION__transaction_id [len=1.3];
 TRANSACTION__transaction_type [shape=ellipse, label="transaction_type"];
 TRANSACTION -- TRANSACTION__transaction_type [len=1.3];
 TRANSACTION__amount [shape=ellipse, label="amount"];
 TRANSACTION -- TRANSACTION__amount [len=1.3];
 TRANSACTION__status [shape=ellipse, label="status"];
 TRANSACTION -- TRANSACTION__status [len=1.3];
 TRANSACTION__description [shape=ellipse, label="description"];
 TRANSACTION -- TRANSACTION__description [len=1.3];
 TRANSACTION__created_at [shape=ellipse, label="created_at"];
 TRANSACTION -- TRANSACTION__created_at [len=1.3];
 ACCOUNT_ENTRY [shape=box, fontname="Times-Bold", label="account_entry", width=1.6, height=0.5];
 ACCOUNT_ENTRY__entry_id [shape=ellipse, label=<<U>entry_id</U>>];
 ACCOUNT_ENTRY -- ACCOUNT_ENTRY__entry_id [len=1.3];
 ACCOUNT_ENTRY__entry_type [shape=ellipse, label="entry_type"];
 ACCOUNT_ENTRY -- ACCOUNT_ENTRY__entry_type [len=1.3];
 ACCOUNT_ENTRY__amount [shape=ellipse, label="amount"];
 ACCOUNT_ENTRY -- ACCOUNT_ENTRY__amount [len=1.3];
 ACCOUNT_ENTRY__balance_after [shape=ellipse, label="balance_after"];
 ACCOUNT_ENTRY -- ACCOUNT_ENTRY__balance_after [len=1.3];
 ACCOUNT_ENTRY__created_at [shape=ellipse, label="created_at"];
 ACCOUNT_ENTRY -- ACCOUNT_ENTRY__created_at [len=1.3];
 ACCOUNT_AUDIT [shape=box, fontname="Times-Bold", label="account_audit", width=1.6, height=0.5];
 ACCOUNT_AUDIT__audit_id [shape=ellipse, label=<<U>audit_id</U>>];
 ACCOUNT_AUDIT -- ACCOUNT_AUDIT__audit_id [len=1.3];
 ACCOUNT_AUDIT__old_balance [shape=ellipse, label="old_balance"];
 ACCOUNT_AUDIT -- ACCOUNT_AUDIT__old_balance [len=1.3];
 ACCOUNT_AUDIT__new_balance [shape=ellipse, label="new_balance"];
 ACCOUNT_AUDIT -- ACCOUNT_AUDIT__new_balance [len=1.3];
 ACCOUNT_AUDIT__changed_by [shape=ellipse, label="changed_by"];
 ACCOUNT_AUDIT -- ACCOUNT_AUDIT__changed_by [len=1.3];
 ACCOUNT_AUDIT__changed_at [shape=ellipse, label="changed_at"];
 ACCOUNT_AUDIT -- ACCOUNT_AUDIT__changed_at [len=1.3];
 TRANSACTION_LOG [shape=box, fontname="Times-Bold", label="transaction_log", width=1.6, height=0.5];
 TRANSACTION_LOG__log_id [shape=ellipse, label=<<U>log_id</U>>];
 TRANSACTION_LOG -- TRANSACTION_LOG__log_id [len=1.3];
 TRANSACTION_LOG__event_type [shape=ellipse, label="event_type"];
 TRANSACTION_LOG -- TRANSACTION_LOG__event_type [len=1.3];
 TRANSACTION_LOG__details [shape=ellipse, label="details"];
 TRANSACTION_LOG -- TRANSACTION_LOG__details [len=1.3];
 TRANSACTION_LOG__logged_at [shape=ellipse, label="logged_at"];
 TRANSACTION_LOG -- TRANSACTION_LOG__logged_at [len=1.3];
 TRANSFER [shape=box, fontname="Times-Bold", label="transfer", width=1.6, height=0.5];
 owns [shape=diamond, label="owns", fontname="Times-Italic", fontsize=12];
 owns -- ACCOUNT [len=2.2, color="black:invis:black"];
 owns -- CUSTOMER [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 posts [shape=diamond, label="posts", fontname="Times-Italic", fontsize=12];
 posts -- ACCOUNT_ENTRY [len=2.2, color="black:invis:black"];
 posts -- TRANSACTION [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 entry_for [shape=diamond, label="entry_for", fontname="Times-Italic", fontsize=12];
 entry_for -- ACCOUNT_ENTRY [len=2.2, color="black:invis:black"];
 entry_for -- ACCOUNT [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 audited_by [shape=diamond, label="audited_by", fontname="Times-Italic", fontsize=12];
 audited_by -- ACCOUNT_AUDIT [len=2.2, color="black:invis:black"];
 audited_by -- ACCOUNT [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 logs [shape=diamond, label="logs", fontname="Times-Italic", fontsize=12];
 logs -- TRANSACTION_LOG [len=2.2];
 logs -- TRANSACTION [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 log_for [shape=diamond, label="log_for", fontname="Times-Italic", fontsize=12];
 log_for -- TRANSACTION_LOG [len=2.2];
 log_for -- ACCOUNT [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8];
 transfer_from [shape=diamond, label="transfer_from", fontname="Times-Italic", fontsize=12];
 transfer_from -- TRANSFER [len=2.2, color="black:invis:black"];
 transfer_from -- ACCOUNT [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8, label="source", fontname="Times-Italic", fontsize=11];
 transfer_to [shape=diamond, label="transfer_to", fontname="Times-Italic", fontsize=12];
 transfer_to -- TRANSFER [len=2.2, color="black:invis:black"];
 transfer_to -- ACCOUNT [len=2.2, dir=forward, arrowhead=normal, arrowsize=0.8, label="destination", fontname="Times-Italic", fontsize=11];
 ISA [shape=invtriangle, label="ISA", fontname="Times-Bold", fontsize=11, width=0.8, height=0.6];
 TRANSACTION -- ISA [len=1.4];
 ISA -- TRANSFER [len=1.4];
}